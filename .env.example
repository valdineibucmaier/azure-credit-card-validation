# .env.example
# Este arquivo lista todas as variáveis de ambiente necessárias para rodar o projeto.
# Para rodar o app, COPIE o conteúdo deste arquivo para um novo arquivo chamado .env
# e insira suas chaves reais do Azure.

# String de conexão do Azure Storage. Use a sua real.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=SEU_ACCOUNT_NAME;AccountKey=SUA_CHAVE_AQUI;EndpointSuffix=core.windows.net"

# Nome do contêiner dentro do Azure Storage.
CONTAINER_NAME="cartoes"

# URL do seu recurso de Cognitive Services (Document Intelligence/Form Recognizer).
ENDPOINT="https://SEU_NOME.cognitiveservices.azure.com/"

# Chave de autenticação para o serviço (KEY ou SUBSCRIPTION_KEY).
SUBSCRIPTION_KEY="SUA_CHAVE_SECRETA_AQUI"
